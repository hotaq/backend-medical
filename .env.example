# Environment Configuration for Medical Triage-BOTS with MedGemma
# Copy this file to .env and update the values as needed

# =============================================================================
# HUGGING FACE CONFIGURATION
# =============================================================================
# Your Hugging Face token for downloading models
HF_TOKEN=your_huggingface_token_here
HUGGINGFACE_HUB_TOKEN=your_huggingface_token_here

# Hugging Face cache directory (optional)
HF_HOME=/app/models
TRANSFORMERS_CACHE=/app/models/transformers
HF_DATASETS_CACHE=/app/models/datasets

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DATABASE_URL=postgresql+asyncpg://medical_user:medical_password_123@localhost:5432/medical_triage_bots
POSTGRES_DB=medical_triage_bots
POSTGRES_USER=medical_user
POSTGRES_PASSWORD=medical_password_123
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# =============================================================================
# API CONFIGURATION
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=info
ENVIRONMENT=production

# =============================================================================
# MEDGEMMA MODEL CONFIGURATION
# =============================================================================
# Model size: small (2b), medium (4b), large (27b)
MEDGEMMA_MODEL_SIZE=medium

# Deployment mode: development, testing, production, high_performance
MEDGEMMA_DEPLOYMENT_MODE=production

# Enable quantization for memory efficiency
MEDGEMMA_QUANTIZATION=true

# Maximum response length
MEDGEMMA_MAX_TOKENS=1024

# Temperature for model responses (0.1 for medical accuracy)
MEDGEMMA_TEMPERATURE=0.1

# =============================================================================
# PERFORMANCE CONFIGURATION
# =============================================================================
# Tokenizers parallelism
TOKENIZERS_PARALLELISM=false

# PyTorch CUDA allocation configuration
PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:512

# CUDA visible devices (set to specific GPU if needed)
CUDA_VISIBLE_DEVICES=0

# =============================================================================
# PYTHON CONFIGURATION
# =============================================================================
PYTHONPATH=/app

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
# Add your security keys here
SECRET_KEY=your_secret_key_here
JWT_SECRET=your_jwt_secret_here

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
LOG_FILE=logs/medical_triage.log
LOG_MAX_SIZE=10MB
LOG_BACKUP_COUNT=5
